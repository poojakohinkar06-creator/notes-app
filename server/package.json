{
  "name": "notes-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Express + better-sqlite3 API for the Notes Application",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:setup": "node db/setup.js",
    "db:seed": "node db/seed.js",
    "test": "node --test --test-timeout=120000 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
